{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LLAMA_CURL": "OFF"
      }
    },
    {
      "name": "hip-gfx1151",
      "displayName": "HIP / gfx1151 (production)",
      "description": "The only supported production target: ROCm HIP on Strix Halo.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGML_HIP": "ON",
        "AMDGPU_TARGETS": "gfx1151",
        "GGML_OPENMP": "OFF",
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_PREFIX_PATH": "/opt/rocm;/opt/rocm/core-10.0"
      }
    },
    {
      "name": "cpu-check",
      "displayName": "CPU only (compile check)",
      "description": "Hosted-runner build: no ROCm, no native tuning. The same preset CI uses.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGML_NATIVE": "OFF",
        "GGML_CCACHE": "OFF"
      }
    },
    {
      "name": "sanitizer",
      "displayName": "CPU + ASan/UBSan",
      "description": "Debug CPU build with sanitizers and tests enabled.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GGML_SANITIZE_ADDRESS": "ON",
        "GGML_SANITIZE_UNDEFINED": "ON",
        "LLAMA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "hip-gfx1151",
      "configurePreset": "hip-gfx1151",
      "targets": ["strix", "strix-server", "llama-quantize", "llama-bench"]
    },
    {
      "name": "cpu-check",
      "configurePreset": "cpu-check",
      "targets": ["strix", "strix-server", "llama-cli", "llama-quantize", "llama-bench"]
    }
  ]
}
